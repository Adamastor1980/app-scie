rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada utilizador só lê e escreve os seus próprios dados
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Fichas públicas dos planos de manutenção (QR no extintor): qualquer pessoa lê uma ficha
    // concreta, se souber o endereço; ninguém lista as fichas; só o dono escreve ou apaga.
    match /publico/{pid} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.dono == request.auth.uid;
      allow update: if request.auth != null && resource.data.dono == request.auth.uid && request.resource.data.dono == request.auth.uid;
      allow delete: if request.auth != null && resource.data.dono == request.auth.uid;
    }
  }
}
